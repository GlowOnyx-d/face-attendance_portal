{
  "name": "face-attendance-portal",
  "private": true,
  "version": "1.0.0",
  "description": "Production-grade face recognition attendance system",
  "type": "module",
  "homepage": "https://github.com/GlowOnyx-d/face-attendance_portal",
  "scripts": {
    "dev": "vite",
    "dev:client": "vite",
    "dev:server": "node --loader dotenv/config server/index.js",
    "dev:full": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:daemon": "node scripts/start-all.mjs",
    "server:install": "npm --prefix server install",
    "build": "vite build",
    "build:server": "tsc --project server/tsconfig.json",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "type-check": "tsc --noEmit",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest --coverage",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist -r https://github.com/GlowOnyx-d/face-attendance_portal.git"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.28.0",
    "axios": "^1.6.5",
    "face-api.js": "^0.22.2",
    "lucide-react": "^0.294.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-router-dom": "^7.13.2",
    "sonner": "^1.2.2",
    "zustand": "^4.4.1"
  },
  "devDependencies": {
    "@babel/preset-env": "^7.24.0",
    "@babel/preset-react": "^7.24.0",
    "@eslint/js": "^9.39.4",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "@testing-library/jest-dom": "^6.1.5",
    "@testing-library/react": "^14.1.2",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "@vitest/ui": "^1.0.4",
    "autoprefixer": "^10.4.16",
    "concurrently": "^9.1.2",
    "dotenv": "^16.3.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "gh-pages": "^6.3.0",
    "globals": "^17.4.0",
    "postcss": "^8.4.31",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "vite": "^8.0.1",
    "vitest": "^1.0.4"
  }
}
